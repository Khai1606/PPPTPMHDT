        <UserObject label="Sơ đồ tuần tự - Tiêu hủy lô thuốc hết hạn / bị khóa" plantUmlId="title_22" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sơ đồ tuần tự - Tiêu hủy lô thuốc hết hạn / bị khóa" id="yWswb_Tsrks2vyLRCV2--174">
          <mxCell parent="AwyGe8WHceRkL7Z4dhP0-389" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
