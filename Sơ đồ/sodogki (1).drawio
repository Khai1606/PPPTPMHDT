        <UserObject label="Sequence Diagram - Thay đổi mật khẩu" plantUmlId="title_35" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence Diagram - Thay đổi mật khẩu (UC_HLT_003)" id="AwyGe8WHceRkL7Z4dhP0-415">
          <mxCell parent="AwyGe8WHceRkL7Z4dhP0-389" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
