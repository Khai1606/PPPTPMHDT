        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - Thay đổi mật khẩu (UC_HLT_003)\n\nautonumber\nactor \&quot;Người dùng\&quot; as User\nparticipant \&quot;Màn hình Đổi mật khẩu\\n(FrmChangePassword)\&quot; as GUI\nparticipant \&quot;UserController\&quot; as Controller\nparticipant \&quot;Bảng NGUOIDUNG\&quot; as DB\n\nUser -&gt; GUI: Nhập Mật khẩu cũ, Mật khẩu mới, Xác nhận và bấm \&quot;Xác nhận\&quot;\nactivate GUI\n\nGUI -&gt; GUI: Kiểm tra Mật khẩu mới và Xác nhận có khớp nhau không\n\nalt Mật khẩu mới khớp nhau\n    GUI -&gt; Controller: doiMatKhau(maND, matKhauCu, matKhauMoi)\n    activate Controller\n    \n    Controller -&gt; DB: SELECT MATKHAU FROM NGUOIDUNG WHERE MAND = maND\n    activate DB\n    DB --&gt; Controller: Trả về mật khẩu hiện tại\n    deactivate DB\n    \n    alt Mật khẩu cũ chính xác\n        Controller -&gt; Controller: Mã hóa mật khẩu mới\n        Controller -&gt; DB: UPDATE NGUOIDUNG SET MATKHAU = ... WHERE MAND = maND\n        activate DB\n        DB --&gt; Controller: Xác nhận cập nhật thành công\n        deactivate DB\n        \n        Controller --&gt; GUI: Đổi mật khẩu thành công\n        GUI --&gt; User: Hiển thị thông báo thành công\n    else Mật khẩu cũ không chính xác\n        Controller --&gt; GUI: Báo lỗi mật khẩu cũ sai\n        GUI --&gt; User: Hiển thị thông báo \&quot;Mật khẩu cũ không chính xác!\&quot;\n    end\n    deactivate Controller\n\nelse Mật khẩu mới không khớp\n    GUI --&gt; User: Hiển thị thông báo \&quot;Mật khẩu mới và xác nhận không trùng khớp!\&quot;\nend\n\ndeactivate GUI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AwyGe8WHceRkL7Z4dhP0-389">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
