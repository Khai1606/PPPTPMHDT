        <UserObject label="Activity Diagram - Tạm khóa / Thu hồi lô thuốc khẩn cấp" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="Activity Diagram - Tạm khóa / Thu hồi lô thuốc khẩn cấp" id="SHf_fsMYSz1kidli0d1P-91">
