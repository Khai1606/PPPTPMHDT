        <UserObject label="Sơ đồ tuần tự - Đăng nhập hệ thống&amp;nbsp;" plantUmlId="title_24" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sơ đồ tuần tự - Đăng nhập hệ thống (UC_HLT_001)" id="AwyGe8WHceRkL7Z4dhP0-364">
          <mxCell parent="AwyGe8WHceRkL7Z4dhP0-344" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="371.88120000000004" x="5804.144127380952" y="-1759.999523809524" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sơ đồ tuần tự - Tạm khóa / Thu hồi lô thuốc khẩn cấp\n\nskinparam sequenceParticipant underline\nskinparam style strictuml\nskinparam sequenceMessageAlign center\n\nactor \&quot;Quản Lý Kho\&quot; as QLK\nparticipant \&quot;FrmThuHoiTieuHuy\&quot; as UI\nparticipant \&quot;LoThuocService\&quot; as Service\ndatabase \&quot;CSDL\&quot; as DB\n\nQLK -&gt; UI : 1. Chọn Mã lô cần thu hồi &amp; nhập Lý do / Số biên bản\nactivate UI\nQLK -&gt; UI : 2. Nhấn \&quot;Khóa / Thu hồi lô\&quot;\nUI -&gt; Service : 3. khoaLoThuocKhanCap(maLo, lyDo, maTaiKhoan)\nactivate Service\n\nService -&gt; DB : 4. UPDATE LOTHUOC SET TRANGTHAI = &#39;Blocked&#39; WHERE MALO = maLo\nactivate DB\nDB --&gt; Service : 5. Xác nhận đã khóa lô (Chặn xuất kho FEFO)\ndeactivate DB\n\nService -&gt; DB : 6. INSERT INTO NHATKYHOATDONG (Ghi vết thu hồi lô)\nactivate DB\nDB --&gt; Service : 7. Xác nhận ghi log bất biến\ndeactivate DB\n\nService --&gt; UI : 8. Trả về trạng thái lô đã bị khóa\nUI --&gt; QLK : 9. Cập nhật nhãn \&quot;Đã khóa\&quot; &amp; thông báo thành công\n\ndeactivate Service\ndeactivate UI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AwyGe8WHceRkL7Z4dhP0-365">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
