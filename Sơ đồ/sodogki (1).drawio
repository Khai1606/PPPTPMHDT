        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sơ đồ Class - Hệ thống Quản lý Kho thuốc &amp; Cảnh báo hết hạn (HLT-03)\n\nskinparam classAttributeIconSize 0\nhide circle\n\nclass TaiKhoan {\n    + PK MaTaiKhoan: String\n    HoTen: String\n    TenDangNhap: String\n    MatKhau: String\n    VaiTro: String\n}\n\nclass ThuKho {\n    MaThuKho: String\n}\n\nclass QuanLyKho {\n    MaQuanLy: String\n}\n\nclass Thuoc {\n    + PK MaThuoc: String\n    TenThuoc: String\n    DonViTinh: String\n    MaNhom: String\n    MoTa: String\n}\n\nclass LoThuoc {\n    + PK MaLo: String\n    MaThuoc: String\n    NgaySanXuat: Date\n    NgayHetHan: Date\n    NgayNhapKho: Date\n    SoLuongTon: Integer\n    TrangThai: String\n}\n\nclass PhieuDieuChinh {\n    + PK MaPhieu: String\n    NgayLap: DateTime\n    NguoiLapId: String\n    NguoiDuyetId: String\n    TrangThai: String\n    LyDoTuChoi: String\n}\n\nclass ChiTietPhieuDieuChinh {\n    + PK MaChiTiet: String\n    MaPhieu: String\n    MaLo: String\n    SoLuongTonSoSach: Integer\n    SoLuongTonThucTe: Integer\n    ChenhLech: Integer\n    LyDoDieuChinh: String\n}\n\nclass PhieuXuat {\n    + PK MaPhieuXuat: String\n    NgayXuat: DateTime\n    MaTaiKhoan: String\n    GhiChu: String\n}\n\nclass ChiTietPhieuXuat {\n    + PK MaCTPX: String\n    MaPhieuXuat: String\n    MaLo: String\n    SoLuongXuat: Integer\n}\n\nclass NhatKyHoatDong {\n    + PK MaLog: String\n    MaTaiKhoan: String\n    HanhDong: String\n    DoiTuongTacDong: String\n    ThoiGian: DateTime\n    ChiTiet: String\n}\n\n&#39; Quan hệ kế thừa (Generalization)\nTaiKhoan &lt;|-- ThuKho\nTaiKhoan &lt;|-- QuanLyKho\n\n&#39; Mối quan hệ liên kết (Associations)\nTaiKhoan \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDieuChinh : \&quot;Lập / Phê duyệt\&quot;\nTaiKhoan \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuXuat : \&quot;Lập phiếu xuất\&quot;\nTaiKhoan \&quot;1\&quot; -- \&quot;0..*\&quot; NhatKyHoatDong : \&quot;Ghi vết thao tác\&quot;\n\nThuoc \&quot;1\&quot; -- \&quot;1..*\&quot; LoThuoc : \&quot;Bao gồm các lô\&quot;\n\nPhieuDieuChinh \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuDieuChinh : \&quot;Bao gồm\&quot;\nLoThuoc \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuDieuChinh : \&quot;Được kiểm kê\&quot;\n\nPhieuXuat \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuXuat : \&quot;Bao gồm\&quot;\nLoThuoc \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuXuat : \&quot;Được xuất kho (FEFO)\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AwyGe8WHceRkL7Z4dhP0-445">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
