          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sơ đồ tuần tự - Nhập lô thuốc mới vào kho (Thủ kho)\n\nskinparam sequenceParticipant underline\nskinparam style strictuml\nskinparam sequenceMessageAlign center\n\nactor \&quot;Thủ Kho\&quot; as TK\nparticipant \&quot;FrmPhieuNhap\&quot; as UI\nparticipant \&quot;LoThuocService\&quot; as Service\ndatabase \&quot;CSDL\&quot; as DB\n\nTK -&gt; UI : 1. Chọn thuốc, nhập MaLo, NSX, HSD, SoLuongNhap\nactivate UI\nTK -&gt; UI : 2. Nhấn \&quot;Lưu phiếu nhập\&quot;\nUI -&gt; Service : 3. nhapLoThuocMoi(duLieuLo, maTaiKhoan)\nactivate Service\n\nService -&gt; Service : 4. Kiểm tra trùng MaLo &amp; điều kiện HSD &gt; NgayHienTai\n\nalt Lô đã hết hạn hoặc trùng mã lô\n    Service --&gt; UI : 5a. Báo lỗi \&quot;Không được phép nhập lô đã hết hạn / trùng mã\&quot;\n    UI --&gt; TK : 6a. Hiển thị cảnh báo chặn nhập\nelse Hợp lệ\n    Service -&gt; DB : 5b. INSERT INTO LOTHUOC (TRANGTHAI = &#39;Active&#39;)\n    activate DB\n    DB --&gt; Service : 6b. Xác nhận lưu lô thuốc mới\n    deactivate DB\n\n    Service -&gt; DB : 7b. INSERT INTO NHATKYHOATDONG (Ghi vết nhập kho)\n    activate DB\n    DB --&gt; Service : 8b. Xác nhận ghi log bất biến\n    deactivate DB\n\n    Service --&gt; UI : 9b. Trả về kết quả &amp; danh sách lô cập nhật\n    UI --&gt; TK : 10b. Hiển thị thông báo nhập kho thành công\nend\n\ndeactivate Service\ndeactivate UI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="SHf_fsMYSz1kidli0d1P-136">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
