        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nhide methods\n\n&#39; --- BẢNG THỰC THỂ ---\n\nclass Tang {\n  + MaTang : PK\n  --\n  TenTang\n  SoLuongPhong\n  ViTriDoCao\n}\n\nclass Phong {\n  + MaPhong : PK\n  --\n  HuongPhong\n  DienTich\n  DonGiaThue\n  TrangThai\n}\n\nclass KhachHang {\n  + MaKH : PK\n  --\n  TenCongTy\n  SoDienThoai\n  Email\n  DiaChi\n  MaSoThue\n}\n\nclass HopDongThue {\n  + MaHopDong : PK\n  --\n  NgayLap\n  NgayBatDau\n  ThoiHanThue\n  TienCoc\n  TrangThai\n}\n\nclass ChiTietHopDong {\n  + MaCTHD : PK\n  --\n  MaHopDong\n  MaPhong\n  DonGiaApDung\n}\n\nclass PhieuGiaHan {\n  + MaPhieuGH : PK\n  --\n  NgayLap\n  ThoiGianGiaHan\n  TrangThaiDuyet\n}\n\nclass HoaDonTienThue {\n  + MaHDThue : PK\n  --\n  ThangNam\n  NgayLap\n  SoTien\n  TrangThaiThanhToan\n}\n\nclass NhanVienCongTy {\n  + MaNV : PK\n  --\n  HoTen\n  ChucVu\n  HinhAnh\n  SoDienThoai\n}\n\nclass TheXe {\n  + MaTheXe : PK\n  --\n  BienSoXe\n  LoaiXe\n  NgayCap\n}\n\nclass HoaDonDichVu {\n  + MaHoaDonDV : PK\n  --\n  ThangNam\n  NgayLap\n  TongTienDV\n  TrangThaiThanhToan\n}\n\nclass ChiTietHoaDonDV {\n  + MaCTHDDV : PK\n  --\n  ChiSoCu\n  ChiSoMoi\n  ThanhTien\n}\n\nclass DichVu {\n  + MaDichVu : PK\n  --\n  MaDichVu\n  TenDichVu\n  DonGia\n  DonViTinh\n}\n\nclass PhieuKiemTra {\n  + MaPhieuKT : PK\n  --\n  NgayKiemTra\n  TinhTrangPhong\n  CoViPhamKetCau\n  TienPhat\n}\n\n&#39; --- MỐI LIÊN KẾT VÀ BẢN SỐ ---\n\nTang \&quot;1\&quot; -- \&quot;1..*\&quot; Phong\nKhachHang \&quot;1\&quot; -- \&quot;1..*\&quot; HopDongThue\nHopDongThue \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietHopDong\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHopDong\n\nHopDongThue \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGiaHan\nHopDongThue \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDonTienThue\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVienCongTy\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVienCongTy\nNhanVienCongTy \&quot;1\&quot; -- \&quot;0..1\&quot; TheXe\n\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDonDichVu\nHoaDonDichVu \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietHoaDonDV\nDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHoaDonDV\n\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKiemTra\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vXg5gY7lE9eIk9Q_Hgvx-79">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
