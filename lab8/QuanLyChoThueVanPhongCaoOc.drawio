        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\n\n&#39; --- TÁC NHÂN BÊN TRÁI ---\nactor \&quot;Khách hàng\&quot; as KH\n\n&#39; --- TÁC NHÂN BÊN PHẢI ---\nactor \&quot;Bộ phận Quản lý\&quot; as BQL\nactor \&quot;Bộ phận Kế toán\&quot; as KT\nactor \&quot;Bộ phận Kỹ thuật\&quot; as KTH\n\n&#39; --- KHU VỰC PHÂN RÃ HỆ THỐNG ---\nrectangle \&quot;Phân rã Quy trình Thuê phòng &amp; Thanh toán Định kỳ\&quot; {\n\n    &#39; Nhóm Hợp đồng đầu kỳ\n    usecase \&quot;Lập &amp; Ký hợp đồng thuê\&quot; as UC_KyHD\n    usecase \&quot;Thanh toán tiền thuê 6 tháng đầu\&quot; as UC_TT6T\n    usecase \&quot;Cập nhật trạng thái phòng\&quot; as UC_CapNhatPhong\n\n    &#39; Nhóm Thanh toán tiền thuê (Tháng 7 trở đi)\n    usecase \&quot;Lập hóa đơn tiền thuê hàng tháng\&quot; as UC_LapHDThue\n    usecase \&quot;Thanh toán tiền thuê hàng tháng\&quot; as UC_TTThueThang\n\n    &#39; Nhóm Chi phí dịch vụ (Cuối tháng)\n    usecase \&quot;Ghi nhận chỉ số dịch vụ\&quot; as UC_GhiCS\n    usecase \&quot;Lập hóa đơn dịch vụ\&quot; as UC_LapHDDV\n    usecase \&quot;Thanh toán hóa đơn dịch vụ\&quot; as UC_TTDV\n\n    &#39; Tiện ích xuất hóa đơn\n    usecase \&quot;In biên nhận thanh toán\&quot; as UC_InBienNhan\n\n    &#39; --- MỐI QUAN HỆ INCLUDE &amp; EXTEND ---\n    UC_KyHD .&gt; UC_TT6T : &lt;&lt;include&gt;&gt;\n    UC_KyHD .&gt; UC_CapNhatPhong : &lt;&lt;include&gt;&gt;\n\n    UC_TTThueThang .&gt; UC_LapHDThue : &lt;&lt;include&gt;&gt;\n    UC_TTThueThang &lt;. UC_InBienNhan : &lt;&lt;extend&gt;&gt;\n\n    UC_LapHDDV .&gt; UC_GhiCS : &lt;&lt;include&gt;&gt;\n    UC_TTDV .&gt; UC_LapHDDV : &lt;&lt;include&gt;&gt;\n    UC_TTDV &lt;. UC_InBienNhan : &lt;&lt;extend&gt;&gt;\n}\n\n&#39; --- KẾT NỐI TÁC NHÂN BÊN TRÁI ---\nKH -- UC_KyHD\nKH -- UC_TT6T\nKH -- UC_TTThueThang\nKH -- UC_TTDV\n\n&#39; --- KẾT NỐI TÁC NHÂN BÊN PHẢI ---\nUC_KyHD -- BQL\nUC_CapNhatPhong -- BQL\n\nUC_TT6T -- KT\nUC_LapHDThue -- KT\nUC_TTThueThang -- KT\nUC_LapHDDV -- KT\nUC_TTDV -- KT\nUC_InBienNhan -- KT\n\nUC_GhiCS -- KTH\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vXg5gY7lE9eIk9Q_Hgvx-39">
