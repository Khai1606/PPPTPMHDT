        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam sequenceMessageAlign center\n\n&#39; --- CHỈ SỬ DỤNG TÁC NHÂN VÀ CÁC CLASS THỰC THỂ Ở CÂU 1 ---\nparticipant \&quot;Khách hàng / Quản lý\&quot; as User\nparticipant \&quot;PhieuGiaHan\&quot; as PhieuGiaHan\nparticipant \&quot;HoaDonTienThue\&quot; as HoaDonTienThue\nparticipant \&quot;HoaDonDichVu\&quot; as HoaDonDichVu\nparticipant \&quot;HopDongThue\&quot; as HopDongThue\n\nUser -&gt; PhieuGiaHan : 1. yeuCauGiaHan(MaHopDong, ThoiGianGiaHan)\nactivate PhieuGiaHan\n\n&#39; --- STEP 1: KIỂM TRA CÔNG NỢ TIỀN THUÊ ---\nPhieuGiaHan -&gt; HoaDonTienThue : 2. kiemTraTrangThaiThanhToan(MaHopDong)\nactivate HoaDonTienThue\nHoaDonTienThue --&gt; PhieuGiaHan : 3. return TrangThaiThanhToan (Boolean)\ndeactivate HoaDonTienThue\n\nalt TrangThaiThanhToan == false\n    PhieuGiaHan --&gt; User : 4a. ThongBao(\&quot;Còn nợ tiền thuê mặt bằng, không thể gia hạn\&quot;)\nelse TrangThaiThanhToan == true\n\n    &#39; --- STEP 2: KIỂM TRA CÔNG NỢ DỊCH VỤ ---\n    PhieuGiaHan -&gt; HoaDonDichVu : 4b. kiemTraTrangThaiThanhToanDV(MaHopDong)\n    activate HoaDonDichVu\n    HoaDonDichVu --&gt; PhieuGiaHan : 5b. return TrangThaiThanhToan (Boolean)\n    deactivate HoaDonDichVu\n\n    alt TrangThaiThanhToan == false\n        PhieuGiaHan --&gt; User : 6a. ThongBao(\&quot;Còn nợ tiền dịch vụ, không thể gia hạn\&quot;)\n    else TrangThaiThanhToan == true\n\n        &#39; --- STEP 3: KIỂM TRA GIỚI HẠN THỜI GIAN GIA HẠN ---\n        PhieuGiaHan -&gt; HopDongThue : 6b. getThoiHanThue(MaHopDong)\n        activate HopDongThue\n        HopDongThue --&gt; PhieuGiaHan : 7b. return ThoiHanThue\n        deactivate HopDongThue\n\n        alt ThoiGianGiaHan &gt; (ThoiHanThue / 2)\n            PhieuGiaHan --&gt; User : 8a. ThongBao(\&quot;Thời gian gia hạn vượt quá 1/2 thời hạn hợp đồng\&quot;)\n        else ThoiGianGiaHan &lt;= (ThoiHanThue / 2)\n\n            &#39; --- STEP 4: LẬP PHIẾU GIA HẠN THÀNH CÔNG ---\n            PhieuGiaHan -&gt; PhieuGiaHan : 8b. taoPhieuGiaHan(MaPhieuGH, NgayLap)\n            PhieuGiaHan --&gt; User : 9. ThongBao(\&quot;Lập phiếu gia hạn thành công\&quot;)\n        end\n    end\nend\n\ndeactivate PhieuGiaHan\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vXg5gY7lE9eIk9Q_Hgvx-410">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
