        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;Bác sĩ điều trị\&quot; as BS\nactor \&quot;NV Chăm sóc khách hàng\&quot; as CSKH\nactor \&quot;NV Thu ngân\&quot; as TN\nactor \&quot;Kỹ thuật viên Xét nghiệm\&quot; as KTV\n\nrectangle \&quot;Hệ thống Quản lý Hồ sơ Bệnh án Bệnh viện\&quot; {\n    usecase \&quot;Đăng ký khám bệnh ban đầu\&quot; as UC_DangKy\n    usecase \&quot;Đóng lệ phí quản lý hằng năm\&quot; as UC_DongLePhi\n    usecase \&quot;Đặt lịch hẹn khám định kỳ\&quot; as UC_DatLich\n    usecase \&quot;Tra cứu hồ sơ bệnh án\&quot; as UC_TraCuu\n    usecase \&quot;Thực hiện khám bệnh\&quot; as UC_KhamBenh\n    usecase \&quot;Chỉ định xét nghiệm\&quot; as UC_ChiDinhXN\n    usecase \&quot;Thực hiện &amp; Cập nhật kết quả XN\&quot; as UC_CapNhatXN\n    usecase \&quot;Lập toa thuốc điều trị\&quot; as UC_LapToa\n    usecase \&quot;Thanh toán viện phí &amp; Xuất viện\&quot; as UC_ThanhToan\n    usecase \&quot;Ghi nhận thông tin đợt khám lên máy tính\&quot; as UC_LuuHoSo\n}\n\n&#39; Liên kết giữa Actor và Use Case\nBN -- UC_DangKy\nBN -- UC_DongLePhi\nBN -- UC_DatLich\nBN -- UC_ThanhToan\n\nCSKH -- UC_DangKy\nCSKH -- UC_DatLich\nCSKH -- UC_LuuHoSo\n\nBS -- UC_TraCuu\nBS -- UC_KhamBenh\nBS -- UC_ChiDinhXN\nBS -- UC_LapToa\n\nKTV -- UC_CapNhatXN\n\nTN -- UC_DongLePhi\nTN -- UC_ThanhToan\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fEhu7UyFBHbQDdj9AQf--807">
