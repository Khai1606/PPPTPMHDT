        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;Bác sĩ điều trị\&quot; as BS\nparticipant \&quot;FormKeToa\&quot; as Form\nparticipant \&quot;QuanLyToaThuoc\&quot; as Ctrl\nparticipant \&quot;ToaThuoc\&quot; as TT\nparticipant \&quot;ChiTietToaThuoc\&quot; as CTTT\nparticipant \&quot;CSDL\&quot; as DB\n\nactivate BS\nBS -&gt; Form : moManHinhKeToa(maPhieuKham)\nactivate Form\n\nForm -&gt; Ctrl : layThongTinKham(maPhieuKham)\nactivate Ctrl\n\nCtrl -&gt; DB : queryThongTinPhieuKham()\nactivate DB\nDB --&gt; Ctrl : traVeThongTin(trieuChung, chanDoan)\ndeactivate DB\n\nCtrl --&gt; Form : hienThiThongTinPhieuKham()\ndeactivate Ctrl\n\nBS -&gt; Form : nhapDanhSachThuoc(maThuoc, soLuong, lieuDung, cachDung)\nForm -&gt; Ctrl : kiemTraDanhSachThuoc(danhSachThuoc)\nactivate Ctrl\nCtrl --&gt; Form : xacNhanHopLe()\ndeactivate Ctrl\n\nBS -&gt; Form : nhanNutLuuVaInToa()\nForm -&gt; Ctrl : luuToaThuoc(maPhieuKham, loiDan, danhSachThuoc)\nactivate Ctrl\n\nCtrl -&gt; TT : create(maPhieuKham, loiDan)\nactivate TT\nTT --&gt; Ctrl : toaThuocCreated\ndeactivate TT\n\nloop cho từng loại thuốc trong danh sách\n    Ctrl -&gt; CTTT : create(maToa, maThuoc, soLuong, lieuDung)\n    activate CTTT\n    CTTT --&gt; Ctrl : chiTietCreated\n    deactivate CTTT\nend\n\nCtrl -&gt; DB : luuToaThuocVaoCSDL()\nactivate DB\nDB --&gt; Ctrl : thongBaoLuuThanhCong()\ndeactivate DB\n\nCtrl --&gt; Form : hienThiThongBaoVaInToa()\ndeactivate Ctrl\n\nForm --&gt; BS : inToaThuocThanhCong()\ndeactivate Form\ndeactivate BS\n\n@endl&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cbi8CT4fWIcK6Zb3EkPh-1">
