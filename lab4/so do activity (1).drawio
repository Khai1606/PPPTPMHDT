        <mxCell id="xPPgcyV-JIZKWvdNzmob-94" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 30px;&quot;&gt;Sơ đồ Sequence&amp;nbsp; chọn và đặt mua hàng&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="910" x="-90" y="1450" as="geometry" />
