        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Bộ phận Nhân sự\&quot; as HR\nactor \&quot;Giám đốc\&quot; as GD\nactor \&quot;Trưởng phòng\&quot; as TP\nactor \&quot;Nhân viên\&quot; as NV\n\nrectangle \&quot;Phân rã Use Case: Quy trình Thử việc -&gt; Ký Hợp đồng Chính thức\&quot; {\n  usecase \&quot;UC4.1: Lập Quyết định tuyển dụng\&quot; as UC1\n  usecase \&quot;UC4.2: Đánh giá kết quả thử việc\&quot; as UC2\n  usecase \&quot;UC4.3: Ký Hợp đồng lao động chính thức\&quot; as UC3\n  usecase \&quot;UC4.4: Lập Hồ sơ Bảo hiểm (BHYT, BHXH)\&quot; as UC4\n  usecase \&quot;UC4.5: Lập Quyết định chức vụ &amp; phụ cấp\&quot; as UC5\n  usecase \&quot;UC4.6: Lập Quyết định lương &amp; phụ cấp\&quot; as UC6\n}\n\n&#39; Liên kết Actor\nHR --&gt; UC1\nGD --&gt; UC1\n\nTP --&gt; UC2\nHR --&gt; UC2\n\nHR --&gt; UC3\nNV --&gt; UC3\n\nHR --&gt; UC4\n\nHR --&gt; UC5\nGD --&gt; UC5\n\nHR --&gt; UC6\nGD --&gt; UC6\n\n&#39; Mối quan hệ Quan trọng\nUC3 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC3 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\nUC4 .&gt; UC3 : &lt;&lt;extend&gt;&gt;\\n(Hợp đồng dài hạn)\nUC5 .&gt; UC3 : &lt;&lt;extend&gt;&gt;\\n(Nếu có chức vụ)\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="L4knqrowE1PYCdCNvEoi-626">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
