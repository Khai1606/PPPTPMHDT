        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass PhongBan {\n  +MaPhongBan: String\n  +TenPhongBan: String\n  +SoDienThoaiPB: String\n  +themPhongBan()\n  +suaPhongBan()\n  +layDanhSachNV()\n}\n\nclass ChucVu {\n  +MaChucVu: String\n  +TenChucVu: String\n  +PhuCapChucVu: Decimal\n  +themChucVu()\n  +capNhatPhuCap()\n}\n\nclass NhanVien {\n  +MaNhanVien: String\n  +HoTen: String\n  +NgaySinh: Date\n  +GioiTinh: String\n  +DiaChi: String\n  +SoDienThoai: String\n  +TrangThai: String\n  +MaPhongBan: String\n  +MaChucVu: String\n  +themNhanVien()\n  +capNhatThongTin()\n  +traCuuNhanVien()\n}\n\nclass QDTuyendung {\n  +SoQDTD: String\n  +MaNhanVien: String\n  +MaPhongBan: String\n  +NgayKy: Date\n  +ThoiGianThuViec: Integer\n  +LuongThuViec: Decimal\n  +NoiDungDieuKhoan: String\n  +lapQDTuyendung()\n  +xemChiTietQDTD()\n}\n\nclass HopDongLaoDong {\n  +SoHopDong: String\n  +MaNhanVien: String\n  +LoaiHopDong: String\n  +NgayBatDau: Date\n  +NgayKetThuc: Date\n  +NoiDungHopDong: String\n  +kyHopDong()\n  +giaHanHopDong()\n  +huyHopDong()\n}\n\nclass HoSoBaoHiem {\n  +MaHoSoBH: String\n  +MaNhanVien: String\n  +SoBHYT: String\n  +SoBHXH: String\n  +MucDong: Decimal\n  +NgayThamGia: Date\n  +taoHoSoBaoHiem()\n  +capNhatBaoHiem()\n  +tinhMucTrichTru()\n}\n\nclass QDLuong {\n  +SoQDLuong: String\n  +MaNhanVien: String\n  +NgayKy: Date\n  +LuongCoBan: Decimal\n  +PhuCapLuong: Decimal\n  +PhuCapDocHai: Decimal\n  +NgayApdung: Date\n  +lapQDLuong()\n  +dieuChinhLuong()\n}\n\nclass QDChucVu {\n  +SoQDChucVu: String\n  +MaNhanVien: String\n  +MaChucVu: String\n  +NgayKy: Date\n  +NgayApdung: Date\n  +NoiDungBoNhiem: String\n  +lapQDChucVu()\n  +boNhiemChucVu()\n}\n\nclass KeHoachPhanCong {\n  +MaKeHoach: String\n  +MaPhongBan: String\n  +Tuan: Integer\n  +Nam: Integer\n  +NgayLap: Date\n  +CaLamViec: String\n  +lapKeHoach()\n  +duyetKeHoach()\n}\n\nclass PhieuPhuTroi {\n  +SoPhieuPhuTroi: String\n  +NgayPhuTroi: Date\n  +SoGioPhuTroi: Float\n  +HinhThuc: String\n  +HeSoLuong: Float\n  +lapPhieuPhuTroi()\n  +tinhGioPhuTroi()\n}\n\nclass ChiTietPhuTroi {\n  +SoPhieuPhuTroi: String\n  +MaNhanVien: String\n  +SoGioPhuTroiCaNhan: Float\n  +GhiChu: String\n  +capNhatGioPhuTroi()\n}\n\nclass BangChamCong {\n  +MaChamCong: String\n  +MaNhanVien: String\n  +Thang: Integer\n  +Nam: Integer\n  +SoNgayCong: Float\n  +SoGioPhuTroiTong: Float\n  +nhapChamCong()\n  +tongHopCongThang()\n}\n\nclass QDKhenThuong {\n  +SoQDKhenThuong: String\n  +NgayKy: Date\n  +LoaiDoiTuong: String\n  +MaDoiTuong: String\n  +LyDo: String\n  +SoTienThuong: Decimal\n  +lapQDKhenThuong()\n  +duyetKhenThuong()\n}\n\nclass QDKyLuat {\n  +SoQDKyLuat: String\n  +NgayKy: Date\n  +LoaiDoiTuong: String\n  +MaDoiTuong: String\n  +LyDo: String\n  +SoTienPhat: Decimal\n  +lapQDKyLuat()\n}\n\nclass PhieuChiKhenThuong {\n  +SoPhieuChi: String\n  +SoQDKhenThuong: String\n  +NgayChi: Date\n  +SoTienChi: Decimal\n  +LyDoChi: String\n  +lapPhieuChi()\n  +inPhieuChi()\n}\n\nclass PhieuThuNopPhat {\n  +SoPhieuThu: String\n  +SoQDKyLuat: String\n  +NgayThu: Date\n  +SoTienThu: Decimal\n  +LyDoThu: String\n  +lapPhieuThu()\n  +inPhieuThu()\n}\n\nclass BangLuong {\n  +MaBangLuong: String\n  +MaNhanVien: String\n  +Thang: Integer\n  +Nam: Integer\n  +LuongCoBan: Decimal\n  +PhuCap: Decimal\n  +LuongPhuTroi: Decimal\n  +TienTrichBH: Decimal\n  +TienKhenThuong: Decimal\n  +TienKyLuat: Decimal\n  +LuongThucLinh: Decimal\n  +tinhLuongThang()\n  +xuatBangLuong()\n}\n\n&#39; Mối liên kết và bản số\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien\nChucVu \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien\nNhanVien \&quot;1\&quot; -- \&quot;1\&quot; QDTuyendung\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; QDTuyendung\nNhanVien \&quot;1\&quot; -- \&quot;1..*\&quot; HopDongLaoDong\nNhanVien \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBaoHiem\nNhanVien \&quot;1\&quot; -- \&quot;1..*\&quot; QDLuong\nNhanVien \&quot;1\&quot; -- \